NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Mentor IA ──────────────────────────────────────────────────────────────
# Key de OpenRouter (https://openrouter.ai → Keys → Create Key).
# SIN el prefijo NEXT_PUBLIC_: así queda solo en el servidor y nunca llega al
# navegador. Nunca subas este valor al repositorio.
OPENROUTER_API_KEY=

# Modelo a usar. Los ':free' son gratuitos pero ROTAN y se descontinúan sin
# aviso: si el mentor empieza a fallar con error 404, casi seguro es esto y se
# arregla cambiando solo esta línea.
# Para ver los que están gratis hoy:
#   https://openrouter.ai/models?max_price=0
# Alternativa probada (usa LaTeX en fórmulas, se ve peor en el chat):
#   openai/gpt-oss-20b:free
# Modelos verificados como disponibles en OpenRouter (agosto 2026):
#   meta-llama/llama-3.3-70b-instruct:free   (recomendado, robusto)
#   google/gemma-3-27b-it:free
#   mistralai/mistral-7b-instruct:free
# Si el mentor falla con error 404, el modelo fue descontinuado — cambia esta línea.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# URL pública del sitio (OpenRouter la usa para atribuir el tráfico).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
