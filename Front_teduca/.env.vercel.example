# ============================================================
# TEDUCA Frontend — Variables de Vercel
# ============================================================
# Configurar en: Vercel Dashboard → teduca → Settings → Environment Variables
# Entorno: Production (y Preview si corresponde)
# ============================================================

# --- Backend (Render) ----------------------------------------------------
# URL del backend FastAPI desplegado en Render.
# Sin barra al final.
NEXT_PUBLIC_API_URL=https://teduca-backend.onrender.com

# --- Mentor IA (OpenRouter) ----------------------------------------------
# SIN prefijo NEXT_PUBLIC_ — esta variable queda solo en el servidor de Vercel
# y nunca llega al navegador del usuario.
#
# Crear key en: https://openrouter.ai → Keys → Create Key
# Modelos gratuitos verificados (pueden cambiar sin aviso):
#   meta-llama/llama-3.3-70b-instruct:free  (recomendado)
#   google/gemma-3-27b-it:free
# Si el mentor falla con 404, el modelo fue descontinuado: cambiar solo esta línea.
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXX
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- URL pública del sitio -----------------------------------------------
# Usada por OpenRouter para atribuir el tráfico y por el backend para
# construir enlaces de verificación de email.
NEXT_PUBLIC_SITE_URL=https://teduca.vercel.app
