# ============================================================
# TEDUCA Backend — Variables de producción (Render)
# ============================================================
# Copia este archivo como .env en Render (Environment Variables).
# NUNCA subas el archivo .env con valores reales al repositorio.
# ============================================================

# --- App -----------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME=TEDUCA
API_V1_PREFIX=/api/v1

# --- Base de datos (Neon pooler) ----------------------------------------
# Obtener desde: https://console.neon.tech → Connection string (pooled, asyncpg)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB

# --- Seguridad / JWT -----------------------------------------------------
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=GENERAR_UNO_NUEVO_NUNCA_REUSAR
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# --- CORS ----------------------------------------------------------------
# El dominio real de Vercel. Si usas dominio propio, agrégalo aquí también.
CORS_ORIGINS=https://teduca.vercel.app,https://www.teduca.pe

# --- Redis (OPCIONAL) ----------------------------------------------------
# Sin Redis el rate limiting funciona en memoria (no protege contra ataques
# distribuidos) y el logout no invalida access tokens hasta su expiración natural.
# Recomendado: Upstash Redis (https://upstash.com) — capa gratuita disponible.
REDIS_URL=

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT_DEFAULT=100/minute

# --- Google OAuth (requerido si activas el botón de Google) -------------
# Crear en: https://console.cloud.google.com → APIs & Services → Credentials
# Tipo: OAuth 2.0 Client ID → Web application
# Authorized JavaScript origins: https://teduca.vercel.app
# Authorized redirect URIs: (no aplica para Identity Services)
ENABLE_GOOGLE_AUTH=true
GOOGLE_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-XXXXXXXX

# --- Email transaccional: Resend (REQUERIDO) -----------------------------
# Crear cuenta en: https://resend.com
# Verificar dominio: teduca.app (o el dominio que uses)
# La dirección FROM debe usar ese dominio verificado.
RESEND_API_KEY=re_XXXXXXXX
RESEND_FROM_EMAIL=TEDUCA <noreply@teduca.app>

# --- URL pública del frontend (REQUERIDO) --------------------------------
# Se usa para construir los enlaces de verificación de email y reset de contraseña.
NEXT_PUBLIC_SITE_URL=https://teduca.vercel.app

# --- Supabase Storage (para subida de archivos) -------------------------
# Crear proyecto en: https://supabase.com → Storage
# Usar la clave SERVICE_ROLE (no la anon key).
SUPABASE_URL=https://XXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_XXXXXXXX
