# --- App ---
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=TEDUCA
API_V1_PREFIX=/api/v1

# --- Database (async) ---
DATABASE_URL=postgresql+asyncpg://teduca:teduca@localhost:5432/teduca

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Security / JWT ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# --- CORS (front en Vercel + local) ---
CORS_ORIGINS=http://localhost:3000,https://teduca.vercel.app

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100/minute
