# --- App ---
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=TEDUCA
API_V1_PREFIX=/api/v1

# --- Database (async) ---
DATABASE_URL=postgresql+asyncpg://teduca:teduca@localhost:5432/teduca

# --- Redis (OPCIONAL) ---
# Vacío = deshabilitado. En serverless (Vercel) déjalo vacío o usa Upstash.
REDIS_URL=

# --- Security / JWT ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# --- CORS (front en Vercel + local) ---
CORS_ORIGINS=http://localhost:3000,https://teduca.vercel.app

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100/minute

# --- Google OAuth (OPCIONAL) ---
# El login con Google NO es obligatorio. Con ENABLE_GOOGLE_AUTH=false (o sin
# GOOGLE_CLIENT_ID) la app funciona igual y el botón de Google queda oculto.
ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email transaccional: Resend (REQUERIDO en producción) ---
# Sin RESEND_API_KEY los emails de verificación, reset de contraseña y
# aprobación de profesor NO se envían (se registra un warning y se continúa).
RESEND_API_KEY=
RESEND_FROM_EMAIL=TEDUCA <noreply@teduca.app>

# --- URL pública del frontend (REQUERIDO en producción) ---
# Se usa para construir los enlaces de verificación de email y reset de
# contraseña que se envían por correo.
NEXT_PUBLIC_SITE_URL=https://teduca.vercel.app

# --- Supabase Storage (OPCIONAL) ---
# Solo si se usa subida de archivos a Supabase. Si se deja vacío, las funciones
# de storage quedan deshabilitadas.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_URL=
