# --- App ---
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=TEDUCA
API_V1_PREFIX=/api/v1

# --- Database (async) ---
DATABASE_URL=postgresql+asyncpg://teduca:teduca@localhost:5432/teduca

# --- Redis (OPCIONAL) ---
# Vacío = deshabilitado. En serverless (Vercel) déjalo vacío o usa Upstash.
REDIS_URL=

# --- Security / JWT ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# --- CORS (front en Vercel + local) ---
CORS_ORIGINS=http://localhost:3000,https://teduca.vercel.app

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100/minute

# --- Google OAuth (OPCIONAL) ---
# El login con Google NO es obligatorio. Con ENABLE_GOOGLE_AUTH=false (o sin
# GOOGLE_CLIENT_ID) la app funciona igual y el botón de Google queda oculto.
ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
